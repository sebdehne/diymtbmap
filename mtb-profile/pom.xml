<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.diymtbmap</groupId>
  <artifactId>mtb-profile</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Norway MTB map - mtb:scale tileset profile (planetiler 0.9.3)</name>
  <description>
    Self-contained Planetiler profile that emits every OSM way tagged with a
    non-empty mtb:scale as a line feature in the "mtb" layer (attribute
    "mtb_scale", raw string value) at z MINZOOM..14, into a dedicated
    mtb.mbtiles overlay tileset. Same planetiler core (0.9.3) as the stock
    openmaptiles/planetiler-openmaptiles v3.16 jar.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.onthegomap.planetiler</groupId>
      <artifactId>planetiler-core</artifactId>
      <version>0.9.3</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>mtb-profile</finalName>
    <plugins>
      <!-- Self-contained fat jar (profile + planetiler + deps), runnable with
           `java -jar mtb-profile.jar`, Main-Class = this profile's main. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.diymtbmap.mtb.MtbMain</mainClass>
                  <manifestEntries>
                    <!-- Required for log4j2's META-INF/versions/* classes (e.g. the
                         properties-configuration factory), same as the stock jar. -->
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <!-- The duplicate .dat registry files clobber each other during
                         shading (last one wins), leaving an incomplete plugin list
                         and breaking log4j2 config discovery. Dropping them makes
                         log4j2 fall back to classpath scanning, exactly like the
                         stock openmaptiles jar (which ships none). -->
                    <exclude>META-INF/org/apache/logging/log4j/core/config/plugins/Log4j2Plugins.dat</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
