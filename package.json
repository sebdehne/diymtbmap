{
  "name": "diymtbmap",
  "version": "0.1.0",
  "private": true,
  "description": "Norway MTB map — downloads OSM, builds OpenMapTiles vector tiles with Planetiler, serves them with Martin and the map UI",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "vendor-fonts": "sh scripts/vendor-fonts.sh",
    "vendor-style": "sh scripts/vendor-style.sh",
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test test/verify.test.ts test/build.test.ts test/martin.test.ts test/style.test.ts test/tiles.test.ts test/fonts.test.ts test/mtb-overlay.test.ts"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "better-sqlite3": "^12.11.1",
    "express": "^4.21.2",
    "pbf": "^5.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "maplibre-gl": "^6.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.1.0"
  }
}
