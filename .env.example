# --- Web app ---------------------------------------------------------------
PORT=8080
# Sub-path the app is served under when behind a reverse proxy that must keep
# other host paths untouched (e.g. nginx "location /mtb/"). The app is mounted
# there AND every browser-facing URL (tiles/sprite/glyphs) carries the prefix.
# Empty (default) = served at the host root. No trailing slash.
BASE_PATH=

# --- Data -------------------------------------------------------------------
DATA_DIR=/data
OSM_URL=https://download.geofabrik.de/europe/norway-latest.osm.pbf
OSM_FILE=/data/norway-latest.osm.pbf
# The persisted tileset artifact (skip rebuild when present).
MBTILES_FILE=/data/openmaptiles.mbtiles

# --- MTB overlay tileset (step 11, decision B1) ------------------------------
# Build-time start zoom of the dedicated low-zoom MTB tileset (integer 0-14,
# default 3). In the image it is a Docker build ARG baked into the ENV:
# docker build --build-arg MTB_MINZOOM=<N>. The tileset records the value it
# was built with (mtb_minzoom metadata) and a mismatch fails fast — change it
# with FORCE_REIMPORT=1 to rebuild.
MTB_MINZOOM=3
# Self-contained mtb-profile jar (planetiler 0.9.3 core), built from
# ./mtb-profile by the image.
MTB_PROFILE_JAR=/opt/planetiler/mtb-profile.jar
# The persisted MTB overlay artifact (ways with mtb:scale, z MTB_MINZOOM-14;
# skip rebuild when present AND its recorded minzoom matches MTB_MINZOOM).
MTB_MBTILES_FILE=/data/mtb.mbtiles
# Max Java heap in MB for the mtb build (only mtb ways, no external data —
# far less than the basemap build).
MTB_HEAP_MB=2048

# --- 3D terrain (OPTIONAL) ---------------------------------------------------
# The persisted elevation tileset (raster DEM, `dem.mbtiles`) for the map's
# 3D-terrain toggle. Built OUTSIDE the container by the standalone
 # tools/dem/build-dem.py converter (Option B — the image has no GDAL/Python)
 # and dropped into the /data volume; Martin serves it and the frontend reads it
# via map.setTerrain. The source id Martin derives from the file name
# (dem.mbtiles -> "dem"), so the served style + toggle follow this name.
# This same dem source ALSO drives the client-side hillshade + contour lines
# (maplibre-contour computes them from these tiles in the browser), so there
# is NO separate contour tileset. OPTIONAL: when this file is absent the whole
# elevation feature degrades away (no `dem` source, no 3D/hillshade/contours)
# and the map is identical to a no-terrain build.
DEM_MBTILES_FILE=/data/dem.mbtiles

# --- Planetiler tileset build ------------------------------------------------
# Self-contained openmaptiles/planetiler-openmaptiles profile jar (v3.16
# release; planetiler 0.9.3 baked in). Installed by the image.
PLANETILER_JAR=/opt/planetiler/planetiler-openmaptiles.jar
# Max Java heap in MB. 768 OOMs in the Natural Earth / water-polygon stage;
# 4096 builds real extracts. Raise further if the full Norway build OOMs.
PLANETILER_HEAP_MB=4096
# Where Planetiler caches its auto-downloaded sources (Natural Earth +
# water polygons) so rebuilds work offline. Default: $DATA_DIR/sources.
#PLANETILER_SOURCES_DIR=/data/sources
# Planetiler temp directory. Default: $DATA_DIR/tmp.
#PLANETILER_TMP_DIR=/data/tmp

# --- Martin tile server (INTERNAL — loopback only, step 12) ------------------
# Martin is an in-container service: the browser NEVER talks to it directly —
# the app proxies /tiles/:source/:z/:x/:y to this loopback URL. Publish ONLY
# the app port (8080) from the container; port 3000 stays internal.
MARTIN_BIND=127.0.0.1
MARTIN_PORT=3000
MARTIN_CONFIG=/app/martin.yaml
# Optional: full tile-source URL the served style.json points at (escape hatch
# for reverse proxies / external tile servers). Leave empty to derive it from
# the browser's request host + the app's own /tiles proxy (the common case).
# e.g. https://mtb.example.com/tiles/openmaptiles
#TILE_SOURCE_URL=

# --- Behaviour ---------------------------------------------------------------
# 1 = force a fresh download + tileset rebuild even if the artifact exists.
FORCE_REIMPORT=0
# 1 = serve the UI + /api/status only; do not run the pipeline at all
# (useful for local development).
SKIP_PIPELINE=0
